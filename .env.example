# URL del API (backend). Solo aplica al frontend (Vite).
# En local: el servidor suele estar en http://localhost:3001
# En producción: definirla en Vercel → Settings → Environment Variables
# (ej. https://pato-api.onrender.com). Vite la incrusta en el build, así que
# después de cambiarla hay que volver a desplegar.
VITE_API_URL=http://localhost:3001

# Cabecera x-api-key que el frontend envía al backend. Debe coincidir con API_SECRET
# en server/.env.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# AVISO: este valor queda incrustado en el bundle JavaScript y es visible para
# cualquiera que abra las herramientas de desarrollo del navegador. NO es un secreto
# ni autenticación real: solo añade fricción frente a bots que escaneen la API.
# Lo que protege el backend de verdad es CORS, el rate limiting y
# ALLOWED_EMAIL_RECIPIENTS.
#
# Si se deja vacío, el frontend no envía la cabecera (desarrollo local sin auth).
VITE_API_SECRET=
