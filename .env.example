# URL del API (backend). Solo aplica al frontend (Vite).
# En local: el servidor suele estar en http://localhost:3001
# En producción: Netlify/Cloudflare inyectan esta variable en el build (ej. https://pato-production.up.railway.app)
VITE_API_URL=http://localhost:3001

# API key para autenticar peticiones al backend. Debe coincidir con API_SECRET en server/.env
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se deja vacío, el frontend no envía cabecera x-api-key (dev local sin auth).
VITE_API_SECRET=

# --- Fase 1: datos compartidos (Supabase) ---
# Sin estas dos variables la app sigue funcionando contra el navegador (Fase 0).
# La anon key es publica por diseno: identifica al proyecto y no autoriza nada;
# quien protege los datos es RLS. La service_role key NUNCA va aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
