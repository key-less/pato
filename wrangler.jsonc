{
  // Cloudflare Workers: frontend estático (Vite + React).
  //
  // El despliegue oficial del frontend es Vercel (ver docs/DEPLOY.md). Este archivo
  // sigue aquí porque la integración de Cloudflare Workers continúa conectada al
  // repositorio y ejecuta el check "Workers Builds: pato" en cada PR: sin config,
  // ese build falla. Para retirar Cloudflare del todo hay que desconectar primero
  // la integración en el dashboard de Cloudflare y después borrar este archivo.
  //
  // SPA: rutas como /playlists o /perfil sirven index.html para que React Router funcione.
  "name": "pato",
  "compatibility_date": "2025-09-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
